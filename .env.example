# NASA FIRMS: obtain a free MAP_KEY from the official FIRMS site.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=PASTE_YOUR_FIRMS_MAP_KEY_HERE

# Optional tuning
FIRMS_TIMEOUT_SECONDS=20
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=30
SENTINEL_LOOKBACK_DAYS=30
SENTINEL_SAMPLE_RADIUS_PIXELS=2
